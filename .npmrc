# better-sqlite3 13 ships prebuilt N-API binaries, but npm (npm/cli#9837) still
# runs an implicit `node-gyp rebuild` for it when installing from the lockfile,
# which fails on machines without a C++ toolchain. No dependency here needs an
# install script (electron-winstaller is unused; fsevents is macOS-only), so skip
# them. Revisit when adding a dependency that must build or download at install.
ignore-scripts=true
