{
  "name": "wrenchpro-monorepo",
  "private": true,
  "description": "WrenchPro: desktop app today, web/mobile SaaS in progress (see docs/architecture)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/desktop",
    "dev": "npm run dev -w apps/desktop",
    "test": "npm test -w apps/desktop",
    "test:all": "npm run test:all -w apps/desktop",
    "electron:dev": "npm run electron:dev -w apps/desktop",
    "electron:build": "npm run electron:build -w apps/desktop",
    "qa:package": "npm run qa:package -w apps/desktop",
    "smoke": "npm run smoke -w apps/desktop",
    "qa:api": "npm run qa:api -w apps/desktop",
    "build:icons": "npm run build:icons -w apps/desktop"
  },
  "engines": {
    "node": ">=22"
  }
}
