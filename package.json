{
  "name": "wrenchpro",
  "version": "1.0.35",
  "description": "WrenchPro Mobile Mechanic Manager",
  "author": "GoldenCrow217",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "electron:dev": "electron .",
    "electron:build": "npm run rebuild-native && electron-builder --win --publish never",
    "electron:publish": "npm run electron:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:linux": "electron-builder --linux",
    "rebuild-native": "electron-rebuild -f -w better-sqlite3",
    "smoke": "node scripts/smoke.js",
    "test": "npm run smoke",
    "qa:api": "node scripts/api-qa.js",
    "qa:ports": "node scripts/port-qa.js",
    "qa:installments": "node scripts/installment-qa.js",
    "qa:mutations": "node scripts/mutation-reliability-qa.js",
    "qa:validation": "node scripts/validation-qa.js",
    "qa:inventory-values": "node scripts/inventory-negative-qa.js",
    "qa:focus-refresh": "node scripts/focus-refresh-qa.js",
    "qa:pricing": "node scripts/pricing-qa.js",
    "qa:dashboard": "node scripts/dashboard-qa.js",
    "qa:printing": "node scripts/print-qa.js",
    "qa:tenant": "node scripts/tenant-qa.js",
    "qa:reliability-corrections": "node scripts/reliability-corrections-qa.js",
    "qa:accounting-integrity": "node scripts/accounting-integrity-qa.js",
    "qa:finance-corrections": "node scripts/finance-corrections-qa.js",
    "test:render-security": "node scripts/run-render-security.js",
    "rebuild-node": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "nodemon": "^3.1.0"
  },
  "build": {
    "appId": "com.wrenchpro.app",
    "productName": "WrenchPro",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "copyright": "Copyright © 2025",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "electron/assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WrenchPro",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "GoldenCrow217",
      "repo": "wrenchpro",
      "releaseType": "release"
    }
  },
  "license": "UNLICENSED"
}
